{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    
    "module": "ESNext",
    "moduleResolution": "Node",
    
    "strict": true,
    "skipLibCheck": true,
    
    "baseUrl": ".",
    "resolveJsonModule": true,
    "isolatedModules": true,
    
    "noEmit": true,
    "incremental": true,
    
    "types": ["node"]
  },

  "include": [
    "artifacts/**/*",
    "scripts/**/*"
  ],

  "exclude": [
    "node_modules",
    "lib/api-spec"
  ]
}